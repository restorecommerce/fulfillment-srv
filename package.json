{
  "name": "@restorecommerce/fulfillments-srv",
  "version": "0.5.3",
  "main": "./dist/start.js",
  "description": "fulfillment service for creating and managing fulfillments",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/fulfillment-srv.git"
  },
  "type": "module",
  "dependencies": {
    "@restorecommerce/acs-client": "^3.2.2",
    "@restorecommerce/cart": "^1.0.9",
    "@restorecommerce/chassis-srv": "^1.9.2",
    "@restorecommerce/grpc-client": "^2.3.2",
    "@restorecommerce/kafka-client": "^1.4.2",
    "@restorecommerce/logger": "^1.4.2",
    "@restorecommerce/rc-grpc-clients": "^5.2.2",
    "@restorecommerce/resource-base-interface": "^1.10.2",
    "@restorecommerce/scs-jobs": "^0.3.2",
    "@restorecommerce/service-config": "^1.2.2",
    "bignumber.js": "^11.1.5",
    "csv-parse": "^7.0.1",
    "dayjs": "^1.11.21",
    "lodash-es": "^4.18.1",
    "openapi-fetch": "^0.17.0",
    "redis": "4.7.1",
    "soap": "<=1.1.6",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@restorecommerce/dev": "^0.3.1",
    "@restorecommerce/protos": "^6.16.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/lodash-es": "^4.17.12",
    "@types/nconf": "^0.10.7",
    "@types/node": "^26.1.1",
    "@types/soap": "<=0.18.0",
    "@types/xml-js": "^1.0.0",
    "async-mutex": "^0.5.0",
    "c8": "^11.0.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.3",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node dist/start.cjs",
    "dev": "cross-env NODE_ENV=development nodemon --watch './src/**/*.ts' --exec node --loader ts-node/esm ./src/start.ts",
    "lint": "eslint src --fix --ignore-pattern **/*.d.ts",
    "build:es": "node esbuild.mjs",
    "build:jobs": "esbuild ./src/jobs/*.ts --bundle --platform=node --outdir=dist/jobs/ --minify --tree-shaking=true --sourcemap=inline --out-extension:.js=.cjs",
    "build:clean": "rimraf dist lib",
    "build": "npm-run-all build:clean build:es build:jobs",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm dist/",
    "test": "npm run lint && vitest run",
    "prepare": "npm-run-all install:husky generate:dhl:rest",
    "install:husky": "node -e \"try { require('husky').install() } catch (e) {}\"",
    "generate:dhl:rest": "openapi-typescript ./api/dhl/rest/parcel-de-shipping-v2.yaml -o src/adapters/dhl/rest/schema.d.ts"
  },
  "engines": {
    "node": ">= 26"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/fulfillment-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/fulfillment-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
