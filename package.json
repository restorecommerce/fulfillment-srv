{
  "name": "@restorecommerce/fulfillments-srv",
  "version": "0.5.3",
  "main": "./dist/start.js",
  "description": "fulfillment service for creating and managing fulfillments",
  "author": "n-fuse GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/restorecommerce/fulfillment-srv.git"
  },
  "type": "module",
  "dependencies": {
    "@restorecommerce/acs-client": "^3.5.2",
    "@restorecommerce/cart": "^1.0.9",
    "@restorecommerce/chassis-srv": "^1.10.3",
    "@restorecommerce/grpc-client": "^2.3.4",
    "@restorecommerce/kafka-client": "^1.4.6",
    "@restorecommerce/logger": "^1.4.4",
    "@restorecommerce/rc-grpc-clients": "^5.2.6",
    "@restorecommerce/resource-base-interface": "^1.10.11",
    "@restorecommerce/scs-jobs": "^0.3.6",
    "@restorecommerce/service-config": "^1.2.4",
    "bignumber.js": "^11.1.5",
    "csv-parse": "^7.0.3",
    "dayjs": "^1.11.23",
    "openapi-fetch": "^0.17.0",
    "redis": "6.4.0",
    "remeda": "^2.62.4",
    "soap": "<=1.1.6",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@alenon/grpc-mock-server": "^3.2.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@restorecommerce/dev": "^0.3.3",
    "@restorecommerce/protos": "^6.18.1",
    "@semantic-release-plus/docker": "^3.1.3",
    "@types/soap": "<=0.18.0",
    "@types/xml-js": "^1.0.0",
    "async-mutex": "^0.5.0",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "rimraf": "^6.1.4",
    "should": "^13.2.3"
  },
  "scripts": {
    "start": "node ./dist/start.cjs",
    "dev": "cross-env NODE_ENV=development node dist/start.cjs",
    "prebuild": "rimraf dist lib coverage",
    "build": "node esbuild.mjs",
    "postbuild": "cp ./node_modules/@platformatic/wasm-utils/dist/native.wasm ./dist/",
    "pretest": "eslint src --fix --ignore-pattern **/*.d.ts",
    "test": "vitest run",
    "prepare": "npm-run-all install:husky generate:dhl:rest",
    "install:husky": "node -e \"try { require('husky').install() } catch (e) {}\"",
    "generate:dhl:rest": "openapi-typescript ./api/dhl/rest/parcel-de-shipping-v2.yaml -o src/adapters/dhl/rest/schema.d.ts"
  },
  "engines": {
    "node": ">= 26"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release-plus/docker",
        {
          "name": "docker.io/restorecommerce/fulfillment-srv",
          "skipLogin": true
        }
      ],
      [
        "@semantic-release-plus/docker",
        {
          "name": "ghcr.io/restorecommerce/fulfillment-srv",
          "skipLogin": true
        }
      ]
    ]
  }
}
